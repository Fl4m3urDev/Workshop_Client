generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  user_id           Int             @id @default(autoincrement())
  username          String          @db.VarChar(100)
  email             String?         @unique @db.VarChar(150)
  subscription_type Subscription    @default(free)
  created_at        DateTime        @default(now())

  // Relations
  actions    UserActions[]
  interests  UserInterests[]
}

model Categories {
  category_id Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(100)

  // Relations
  articles   Articles[]
  interests  UserInterests[]
}

model UserInterests {
  user_id     Int
  category_id Int

  // Relations
  user     Users     @relation(fields: [user_id], references: [user_id])
  category Categories @relation(fields: [category_id], references: [category_id])

  @@id([user_id, category_id])
}

model Articles {
  article_id   Int          @id @default(autoincrement())
  title        String       @db.VarChar(255)
  content      String       @db.Text
  author       String?      @db.VarChar(150)
  category_id  Int?
  published_at DateTime     @default(now())
  highlighted  Boolean      @default(false)
  views_count  Int          @default(0)
  likes_count  Int          @default(0)

  // Relations
  category   Categories?   @relation(fields: [category_id], references: [category_id])
  tags       ArticleTags[]
  actions    UserActions[]
}

model Tags {
  tag_id Int    @id @default(autoincrement())
  name   String @unique @db.VarChar(100)

  // Relations
  articles ArticleTags[]
}

model ArticleTags {
  article_id Int
  tag_id     Int

  // Relations
  article Articles @relation(fields: [article_id], references: [article_id])
  tag     Tags     @relation(fields: [tag_id], references: [tag_id])

  @@id([article_id, tag_id])
}

model UserActions {
  action_id   Int        @id @default(autoincrement())
  user_id     Int
  article_id  Int
  action_type ActionType
  action_date DateTime   @default(now())

  // Relations
  user    Users    @relation(fields: [user_id], references: [user_id])
  article Articles @relation(fields: [article_id], references: [article_id])
}

model Newsletter {
  newsletter_id Int @id @default(autoincrement())
}

enum Subscription {
  free
  subscriber
}

enum ActionType {
  view
  like
  share
  newsletter_click
}
